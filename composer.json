{
    "name": "tweakwise/magento2-tweakwise-export",
    "license": "OSL-3.0",
    "description": "Magento 2 module for Tweakwise export",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "laminas/laminas-http": "^2.15.0",
        "magento/module-configurable-product": "*",
        "magento/module-grouped-product": "*",
        "magento/inventory-metapackage": "*"
    },
    "require-dev": {
        "emico/code-quality": "^10.8"
    },
    "replace": {
        "emico/tweakwise-export": "v4.2.4"
    },
    "type": "magento2-module",
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Tweakwise\\Magento2TweakwiseExport\\": "src/"
        }
    },
    "repositories": {
        "emico": {
            "type": "composer",
            "url": "https://git.emico.io/api/v4/group/239/-/packages/composer/",
            "only": [
                "emico/code-quality",
                "emico/codeception-m2",
                "hipex/magento-2-psr7-bridge"
            ]
        },
        "magento": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "emico/code-quality": true,
            "magento/composer-dependency-version-audit-plugin": true,
            "magento/inventory-composer-installer": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true
        }
    }
}
